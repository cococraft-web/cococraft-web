rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Public website visitors can read images and media assets
      allow read: if true;
      // Only authenticated admin can upload, modify, or delete storage assets
      // Enforce file size limit of 100MB for media uploads
      allow write: if request.auth != null 
                   && (request.resource == null || request.resource.size < 100 * 1024 * 1024);
    }
  }
}
